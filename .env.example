# Proveedor del modelo: anthropic | openai | simulado
#   anthropic → API de Anthropic (Claude)
#   openai    → cualquier API compatible con OpenAI Chat Completions (OpenAI u otros, vía LLM_BASE_URL)
#   simulado  → guion fijo SIN modelo, solo para probar la interfaz sin clave (no cumple el reto por sí solo)
LLM_PROVIDER=anthropic
# Clave del proveedor. Solo se lee en el backend; nunca se expone en el front, la API ni los logs.
LLM_API_KEY=
# Modelo. Con anthropic, si se deja vacío se usa claude-sonnet-5-5. Con openai es obligatorio
# (p. ej. gpt-4.1-mini; verifica en tu cuenta de OpenAI qué modelos tienes disponibles).
LLM_MODEL=
# Solo para proveedores compatibles con OpenAI distintos de OpenAI (ver README).
LLM_BASE_URL=

# Límites de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=500000
MAX_TOKENS_RESPUESTA=4096
LLM_TIMEOUT_MS=60000

# Clave opcional para proteger el link público (el front la pide una vez). Vacío = sin protección.
ACCESS_KEY=
# Fecha de referencia fija (YYYY-MM-DD) para vigencias/registros. Vacío = fecha actual en Colombia.
FECHA_REFERENCIA=
PORT=3000
